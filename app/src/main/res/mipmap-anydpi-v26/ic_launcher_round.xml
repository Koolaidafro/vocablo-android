<?xml version="1.0" encoding="utf-8"?>
<!-- Round Tuzo launcher icon (FR-18). The art layer carries the full generated icon on its jade
     background; the background layer is the same jade, so any mask shape looks seamless. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_art" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
