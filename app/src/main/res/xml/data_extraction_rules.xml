<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Tutor API keys never leave the phone, not even to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="tutor_keys.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tutor_keys.xml" />
    </device-transfer>
</data-extraction-rules>
